# Dealer Social AI - LOCAL settings example.
# Copy to .env (git-ignored) and fill in. Never commit .env. Never paste keys in chat.

# Shared secret the Dealer Social demo app sends with every request (32+ characters).
# Generate one:  py -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_TOKEN=

# Meta Model API. Off by default; turn on once your key is in place.
META_AI_ENABLED=true
MODEL_API_KEY=

# Optional overrides (defaults shown). Contributor model variants are refused.
# META_BASE_URL=https://api.meta.ai/v1
# META_TEXT_MODEL=muse-spark-1.3
# META_VOICE_MODEL=muse-voice-transcribe-1.0
# META_SAM_MODEL=sam-3.1
# META_IMAGE_MODEL=muse-image-1.0
# META_REASONING_EFFORT=low          # minimal | low | medium | high

# Credit protection (defaults shown).
# MAX_CONCURRENT_META_CALLS=4
# RATE_LIMIT_PER_CLIENT_PER_MINUTE=20
# RATE_LIMIT_GLOBAL_PER_MINUTE=60
# RATE_LIMIT_GLOBAL_PER_DAY=1000
# VOICE_LIMIT_PER_CLIENT_PER_MINUTE=6
# VOICE_LIMIT_GLOBAL_PER_DAY=300
# PHOTO_LIMIT_PER_CLIENT_PER_MINUTE=10
# PHOTO_LIMIT_GLOBAL_PER_DAY=500

# Test page at /playground (on by default).
# PLAYGROUND_ENABLED=true
